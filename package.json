    "test:journeys": "npm run build && npm run test:journeys:built",
    "test:journeys:built": "playwright test",
    "test:golden": "node tests/golden.mjs",
    "test:golden:update": "node tests/golden.mjs --update",
    "tax-rules:validate": "node scripts/tax-rules/validate.mjs",
    "tax-rules:test": "node --test tests/tax-rules/*.test.mjs",
    "tax-rules:diff": "node scripts/tax-rules/diff.mjs",
    "tax-rules:keygen": "node scripts/tax-rules/bootstrap-key.mjs",
    "tax-rules:sign": "node scripts/tax-rules/sign.mjs",
    "tax-rules:verify": "node scripts/tax-rules/verify.mjs",
    "tax-rules:promote": "node scripts/tax-rules/promote.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
