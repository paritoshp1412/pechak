{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pechak.example/schemas/tax-rule-index-v1.schema.json",
  "title": "Pechak tax rule index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jurisdiction", "updatedAt", "releases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jurisdiction": { "const": "IN" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "financialYear",
          "assessmentYear",
          "version",
          "rulePackVersion",
          "status",
          "publishedAt",
          "minimumAppVersion",
          "path",
          "signaturePath",
          "keyId",
          "publicKeyPath",
          "sha256"
        ],
        "properties": {
          "financialYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "assessmentYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "version": { "type": "integer", "minimum": 1 },
          "rulePackVersion": { "type": "string", "pattern": "^in-fy[0-9]{4}-[0-9]{2}-v[1-9][0-9]*$" },
          "status": { "enum": ["final", "withdrawn"] },
          "publishedAt": { "type": "string", "format": "date-time" },
          "minimumAppVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "path": { "type": "string", "pattern": "^tax-rules/in/fy-[0-9]{4}-[0-9]{2}/v[1-9][0-9]*\\.json$" },
          "signaturePath": { "type": "string", "pattern": "^tax-rules/in/fy-[0-9]{4}-[0-9]{2}/v[1-9][0-9]*\\.sig$" },
          "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
          "publicKeyPath": { "type": "string", "pattern": "^tax-rules/keys/[a-z0-9][a-z0-9-]{2,80}\\.pub\\.pem$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
