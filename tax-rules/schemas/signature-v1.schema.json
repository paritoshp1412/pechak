{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pechak.example/schemas/tax-rule-signature-v1.schema.json",
  "title": "Pechak detached tax rule signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "algorithm", "keyId", "canonicalization", "sha256", "signature"],
  "properties": {
    "formatVersion": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "canonicalization": { "const": "RFC8785" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  }
}
